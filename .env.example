# Copy to .env.local. Never commit real values.

# YouCam: https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=
# Live use stops here, so visitors cannot spend all the free units.
YOUCAM_UNIT_BUDGET=400

# Local: bolt://localhost:7687 with the password you choose for docker compose.
# Cloud: the neo4j+s:// address from https://console.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Set to 1 to show only the project's own images, with no brand or seller names.
BRAND_FREE=
